/* Authoritative glossary copied verbatim from lib/l10n/app_en.arb. */
"glBackupBody" = "Saves keys, badges and settings into an encrypted file. Without it everything is lost when the device is — no phone, no reputation. Create it early, not when you need it, and keep the file separate from the password.";
"glBackupTitle" = "The backup";
"glBadgeProofBody" = "That you were at a particular place at a particular time — confirmed by someone who was there too. The confirmation is a Schnorr signature per BIP-340. Nobody can forge it, not even the developers, because that would require the organiser's private key.";
"glBadgeProofTitle" = "What a badge proves";
"glBadgeShareBody" = "Open a badge and tap share in the top right. The app renders an image with place, date, block height and checksum. Anyone who sees it can follow the details — your private key is not in there.";
"glBadgeShareTitle" = "Sharing a badge";
"glBlockHeightBody" = "Every badge carries the number of the Bitcoin block that was current at scan time. It acts as a timestamp nobody can move afterwards — unlike a phone clock, which can be set to anything.";
"glBlockHeightTitle" = "The block height";
"glCalendarSourcesBody" = "The calendar merges two sources: events from the Einundzwanzig portal and ones somebody entered via Nostr. Colour tells them apart — portal meetups orange, Nostr events cyan.";
"glCalendarSourcesTitle" = "Where events come from";
"glChecksumBody" = "A short fingerprint over the whole badge content. Two people can compare badges from the same meetup: if the checksums match, both received the same data. It appears in the badge details and on the shared image.";
"glChecksumTitle" = "The checksum";
"glCollectBody" = "Go to the meetup and ask the organiser to show the QR code. Tap the round scan button in the bottom bar, capture the code — done. The badge then sits in your badge wallet.";
"glCollectTitle" = "How to collect a badge";
"glCommunityBody" = "A hub for everything around Einundzwanzig that is not directly about badges: podcast, shoutouts, PlebRap, SatoshiDuell and the meetup map. Much of it opens in the browser.";
"glCommunityTitle" = "Community section";
"glConverterBody" = "Converts euro to sats and back. Price and block height come from a mempool instance; which one is up to you in the settings — your own node, for example.";
"glConverterTitle" = "Converter and price";
"glCreateEventBody" = "Anyone can add an event — it is published signed on Nostr and appears in everyone's calendar. Only organisers and leaders, however, may attach a badge to it.";
"glCreateEventTitle" = "Creating an event";
"glDegreesBody" = "First degree means you were with the same organiser. Second degree: someone you met has met that person. If a meetup had two organisers, their scanning each other bridges both groups — you are then connected at second degree instead of first.";
"glDegreesTitle" = "Degrees";
"glDistrustBody" = "Organisers can report abuse. If reports against someone pile up, they are marked as suspended in the network — their badges do not vanish but carry that warning. A report is signed too and thus attributable to its author.";
"glDistrustTitle" = "Reports and suspension";
"glDuplicateBody" = "There is exactly one badge per meetup and day. Scanning the same code twice does not give you a second one — by design: a badge stands for a visit, not for a scan.";
"glDuplicateTitle" = "Duplicate badges";
"glEncounterBody" = "Anyone who scanned with the same organiser on the same day counts as having met. That forms a web of people who actually shared a room — not of people who follow each other online.";
"glEncounterTitle" = "Encounters";
"glEventHelperBody" = "Whoever creates an event with a badge can list any npubs as issuers. Those helpers need no organiser role — the permission lives in the event and applies to that one event only. Each helper shows their own QR code.";
"glEventHelperTitle" = "Helpers at an event";
"glEventNetBody" = "Special events are counted separately. At a meetup with fifteen people you meet everyone — at an event with five hundred you do not. Mixing both would devalue what the network says, so events have their own category.";
"glEventNetTitle" = "Event network";
"glEventWindowBody" = "An event badge can only be issued on the day of the event and only near the registered location. Together this prevents somebody handing out badges from home for an event they are not attending.";
"glEventWindowTitle" = "Location and time window";
"glFindKeysBody" = "Settings → Profile, at the very bottom. There you copy the npub with one tap and reveal the nsec — the latter only after a warning, because whoever sees the nsec has your identity. If you use Amber, a browser extension or a bunker there is no nsec here: it lives there, not in this app.";
"glFindKeysTitle" = "Where are my keys?";
"glFindMeetupBody" = "The meetup search lists every registered group. Nearby instead shows what is around your current location — useful when travelling or when looking for a second group in the region.";
"glFindMeetupTitle" = "Finding meetups";
"glHomeMeetupBody" = "The meetup you attend regularly. It decides which events you see first and which crest appears on your badges. You can pick several favourites — the first counts as your home meetup. You can change it any time in your profile.";
"glHomeMeetupTitle" = "Your home meetup";
"glHumanityBody" = "A single lightning zap shows that a person with a real wallet stands behind the profile. It is the most effective guard against automatically created accounts in the web of trust. Optional — the app works without it.";
"glHumanityTitle" = "Proof of humanity";
"glImportBody" = "If you already have a Nostr identity you can use it here — as nsec, as ncryptsec or via a bunker. Your existing contacts and profile stay intact; the app only adds badges and reputation.";
"glImportTitle" = "Bringing your own key";
"glKeysBody" = "Your npub is your public address — share it freely. The nsec is the private key and belongs to nobody else: whoever has it IS you. There is no reset. If the nsec is gone, the identity and its reputation are gone with it.";
"glKeysTitle" = "nsec and npub";
"glLanguageBody" = "The app is available in German, English and Spanish. Without an explicit choice it follows the system language. You can switch it in the settings; the change takes effect immediately, no restart needed.";
"glLanguageTitle" = "Language";
"glLevelsBody" = "As your trust score grows you reach higher levels. From a certain level you can run sessions and issue badges yourself — that is not an award but a responsibility: your signature then sits under other people's badges.";
"glLevelsTitle" = "The levels";
"glLogBody" = "A record of what the app does in the background — which relays answered, why a scan was rejected. When something goes wrong this is the first place to look. It stays on the device and is never uploaded.";
"glLogTitle" = "Diagnostics log";
"glNcryptsecBody" = "An nsec encrypted with a password (NIP-49). The string starts with ncryptsec1 and is worthless without the password — so it travels more safely than a bare nsec. This is also how your key sits on the device.";
"glNcryptsecTitle" = "ncryptsec";
"glNewsBody" = "The articles come from the Einundzwanzig magazine and exist as Nostr long-form posts. You can read them in the app, like them, share them and zap the authors sats — all with the same identity.";
"glNewsTitle" = "The news section";
"glNicknameBody" = "The name you appear under in the network. It is freely chosen, need not be your real one and can be changed any time — your identity hangs on the key, not on the name.";
"glNicknameTitle" = "Your display name";
"glNip05Body" = "A readable address of the form name@domain pointing to your key — like a name tag for the network. It shows that somebody with access to that domain vouches for you, but replaces none of the other checks.";
"glNip05Title" = "NIP-05 address";
"glNostrBasicsBody" = "An open protocol for messages signed by their own author. There is no company behind it and no account that could be suspended — only keys and relays. That is why the identity from this app also works in other Nostr applications.";
"glNostrBasicsTitle" = "What Nostr is";
"glOfflineBody" = "Scanning and receiving a badge works offline — your device verifies the signature itself. Without a connection you only lose what comes from outside: block height, price, events and the check whether the organiser is registered.";
"glOfflineTitle" = "What works offline";
"glOnSiteBody" = "Besides the rotating code the app also checks distance: anyone too far from the meetup gets no badge. For meetups the limits are generous because some groups cover whole regions; for special events the location is precise and the limit tight.";
"glOnSiteTitle" = "Why only on site";
"glOrganizerBody" = "From a certain trust score you can run sessions yourself. On top of that you usually need vouches from existing organisers — the role is not granted, it grows out of the network.";
"glOrganizerTitle" = "Becoming an organiser";
"glPasskeyBody" = "Extra protection via fingerprint or face recognition. The passkey does not replace your password, it sits in front of it. Optional, and only on this device — on a new one you need the password or backup again.";
"glPasskeyTitle" = "Passkey";
"glPasswordBody" = "During setup you set a password that wraps your key on the device. For a backup you set a second one that encrypts the backup file. They may be identical but are independent — and neither can be reset.";
"glPasswordTitle" = "The two passwords";
"glPlatformsBody" = "You can link accounts such as Telegram or X to your Nostr identity. Every confirmed platform feeds into the trust score and shows others that an established person stands behind the profile. Also optional.";
"glPlatformsTitle" = "Platform proofs";
"glPortalBody" = "You can sign in to the Einundzwanzig portal with your Nostr key. You then see the events and courses maintained there and, as a leader, can create your own. Everything else keeps working without the connection.";
"glPortalTitle" = "The portal connection";
"glPublicBody" = "Badges, attendance records and vouches sit openly on the relays — anyone can read and verify them, which is the whole point. Not public are your private key, your backup password and your exact location.";
"glPublicTitle" = "What is public";
"glPublishBody" = "For others to check your reputation it has to be on the relays. The app publishes it signed; without that step a counterpart only sees what you show them directly.";
"glPublishTitle" = "Publishing your reputation";
"glRelaysBody" = "Relays are the servers Nostr messages travel through. The app writes to several at once so nothing is lost when one fails. You can add your own in the settings — they are checked for reachability before being saved.";
"glRelaysTitle" = "Relays";
"glRepCardBody" = "A shareable overview of your reputation as an image — level, number of meetups, time span. It contains no private key and can be posted without worry.";
"glRepCardTitle" = "The reputation card";
"glResetBody" = "Deletes profile, keys and all badges from the device — permanently. Without a backup your identity is gone afterwards, even though the badges live on in the relays: without the matching key you can no longer claim them. Make a backup first.";
"glResetTitle" = "Resetting the app";
"glRestoreBody" = "During setup you can load a backup instead of creating a new key. You need the file AND the password it was encrypted with — one alone is not enough. Afterwards the identity and its badges are back.";
"glRestoreTitle" = "Restoring a backup";
"glRollingQrBody" = "The organiser's code changes every few seconds. A photo of it is worthless minutes later — only someone actually standing in front of it can capture it. That is exactly why a badge cannot be passed on via chat.";
"glRollingQrTitle" = "The rolling QR";
"glSignerBody" = "Instead of keeping the key in this app you can entrust it to a signer app such as Amber or connect it through a bunker. This app then asks there for every signature and never sees the key itself.";
"glSignerTitle" = "Signer apps";
"glSpecialEventBody" = "Besides the regular meetups there are one-off events with their own badges. They count as a badge and towards the variety of issuers, but not as a meetup visited — three large events do not replace a local community.";
"glSpecialEventTitle" = "Special events";
"glTilesBody" = "Press and hold a tile to move or hide it. Trust score and home meetup always stay; everything else can be unpinned. Hidden tiles go to the tile manager and can be brought back any time.";
"glTilesTitle" = "Customising the dashboard";
"glTrustPathBody" = "Shows the chain connecting you to another person — who met whom and where. An abstract number becomes a statement you can follow: not just that you are connected, but through what.";
"glTrustPathTitle" = "Trust path";
"glTrustScoreBody" = "A number summarising how solid your attendance record is. Quantity alone does not decide it: different meetups, different organisers and regularity over time weigh more than twenty visits to the same place in one week.";
"glTrustScoreTitle" = "The trust score";
"glVerifyPersonBody" = "Have the other person show their reputation QR and scan it. The app verifies whether the claims match the signed badges and shows how you are connected in the network. Useful before trading with a stranger.";
"glVerifyPersonTitle" = "Verifying someone";
"glVouchBody" = "Organisers can vouch for each other. A vouch is a public, signed statement — once published the whole network sees who you stand for. It can be withdrawn at any time, but the withdrawal is just as visible.";
"glVouchTitle" = "Vouches";
"glWhatIsAppBody" = "It proves you were physically present at a Bitcoin meetup. Over time those proofs add up to a reputation that belongs to you and that nobody can revoke — it does not sit on an Einundzwanzig server but signed on the Nostr network.";
"glWhatIsAppTitle" = "What this app does";
"glWorldMapBody" = "Shows your collected badges where you received them. A list of names turns into a map of your meetup visits — handy for spotting where the blank areas still are.";
"glWorldMapTitle" = "The badge world map";
"glZapBody" = "A zap is a small lightning payment with a Nostr receipt attached. In the news section you can send authors something directly; the app hands the invoice to your wallet. A single zap also serves as proof of humanity.";
"glZapTitle" = "Zaps";

