// Gemeinsame Einstellungen fuer die native iOS- und macOS-App.
PRODUCT_NAME = Einundzwanzig
PRODUCT_BUNDLE_IDENTIFIER = space.einundzwanzig.meetup.apple
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17
CLANG_CXX_LANGUAGE_STANDARD = gnu++20

GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Configuration/Info.plist
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphone*] = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
LOCALIZATION_PREFERS_STRING_CATALOGS = NO

CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Configuration/Einundzwanzig-macOS.entitlements
ENABLE_APP_SANDBOX[sdk=macosx*] = YES
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS[sdk=macosx*] = YES
ENABLE_RESOURCE_ACCESS_CALENDARS[sdk=macosx*] = YES

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
